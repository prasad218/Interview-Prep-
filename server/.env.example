# ---- Required ----
OPENROUTER_API_KEY=sk-or-v1-...
JWT_SECRET=change-me-to-a-long-random-string

# ---- Model / cost control ----
# "openrouter/free" routes each request to an available zero-cost model.
# You can also pin a specific free model, e.g. a model id ending in ":free".
DEFAULT_MODEL=openrouter/free

# Leave unset (or "false") to show ONLY free models in the picker.
# Set to "true" to expose the full paid OpenRouter catalogue again.
ALLOW_PAID_MODELS=false

# ---- Optional ----
GOOGLE_CLIENT_ID=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Interview Prep
PORT=3001
