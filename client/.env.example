# Leave empty for local dev (Vite proxies /api to the server automatically).
# In production, set this to your deployed server's URL, e.g.
# https://interview-prep-api.onrender.com
VITE_API_URL=

# Optional — only needed for the "Sign in with Google" button. Create an
# OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add this exact
# origin under "Authorized JavaScript origins". Use the SAME client ID as
# GOOGLE_CLIENT_ID in server/.env.
VITE_GOOGLE_CLIENT_ID=
